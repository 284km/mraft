// mraft.mere — a replicated log: three nodes agree on a sequence of commands,
// and keep agreeing when one of them stops.
//
//   $ mere -c mraft.mere > m.c && clang -O2 m.c -o mraft
//   $ ./mraft 1 7001 7001 7002 7003    # id, my port, then every port in id order
//   $ ./mraft 2 7002 7001 7002 7003
//   $ ./mraft 3 7003 7001 7002 7003
//   $ printf 'PROP hello\n' | nc 127.0.0.1 7001     # to whichever node is leader
//
// M3: a durable log. Everything Raft requires to survive a crash — the current
// term, the vote, and every entry — is written and fsynced *before* the node acts
// on it, so a killed process comes back with what it promised rather than with
// nothing. M0 established the failure vocabulary, M1 elected a leader, M2 made the
// cluster agree on a sequence; this is the slice where the agreement outlives the
// processes that made it.
//
// The write-ahead log is text, one record per line, in the order things happened:
//
//   T <term> <voted-for>          the vote in a term; the last one wins
//   E <index> <term> <command>    an entry at that index
//
// An `E` at an index the log already has means the entry there was **replaced**,
// so replay drops everything above it. That is how a follower's truncation is
// recorded without a truncate syscall: rewriting history is an append.
//
// ---- the shape this program is built around --------------------------------
//
// A node has to serve peers that dial it, dial the peers it needs, keep its own
// state consistent, and notice that time has passed. Mere's `channel_recv` waits
// forever and the only bounded wait in the runtime is a socket timeout, so rather
// than fight that, **time is a message**: a ticker thread sends `Tick` into the
// same inbox as every network event, and the node performs no timed wait at all.
//
//   ticker  ──Tick──────┐
//   reader ──RequestVote┤
//   reader ──Append─────┼──> inbox ──> node (owns all state, one thread)
//   reader ──Propose────┘                │
//                                        └──> per-peer outbox ──> sender ──> TCP
//
// With every input arriving as an event there is one place where state changes, so
// the state needs no lock and never crosses a thread boundary, and the rules are
// ordinary functions from a state and an event to a state.

extern fn tcp_listen: int -> int;
extern fn tcp_accept: int -> int;
extern fn tcp_connect: str -> int -> int;
extern fn tcp_read: int -> int -> int -> int;
extern fn tcp_write: int -> int -> int -> int;
extern fn tcp_close: int -> unit;
extern fn now_ms: unit -> int;
extern fn mem_alloc: int -> int;
extern fn mem_get_u8: int -> int -> int;
extern fn mem_copy_str: int -> int -> str -> int;

// Raft's one timing law is `heartbeat << election timeout << mean time between
// failures`. The spread is what breaks split votes: if every node waited the same
// time they would all become candidates together, split the vote, and do it again
// forever. Randomising means someone almost always goes first.
let heartbeat_ms = 150;
let election_min_ms = 800;
let election_spread_ms = 600;
let tick_ms = 50;

let bufsz = 4096;

// ---- state -----------------------------------------------------------------
type role = Follower | Candidate | Leader;

// An entry is a term and a command. The term is not decoration: it is how two
// logs are compared, and how a leader knows which of its entries are safe to
// commit.
type entry = Entry of (int * str);

// The log is kept newest-first, so appending is a cons and `size` is the last
// index. Reading index `i` walks `size - i` links, which is the wrong complexity
// for a real system and the right amount of code for this one — a growable Vec
// would have to outlive the region it was made in, and the actor loop has no
// region to put one in.
type node = {
  id: int,
  term: int,
  part: role,
  voted_for: int,        // -1 when this node has not voted in `term`
  votes: int,            // votes received as a candidate, including its own
  deadline: int,         // now_ms() past which a follower calls an election
  last_beat: int,        // when this node, as leader, last sent heartbeats
  leader: int,           // who it believes the leader is, -1 for nobody
  log: entry list,       // newest first
  size: int,             // last index, i.e. the length of `log`
  commit: int,           // highest index known to be committed
  applied: int,          // highest index handed to the state machine
  peers: (int * int * int) list,  // (peer id, next index to send, match index)
  wal: File,             // the write-ahead log, open for append
  wal_end: int           // how many bytes of it are written
};

// What a leader sends. A record rather than a seven-wide tuple, because the
// fields are only distinguishable by name.
type append = {
  a_term: int,
  a_leader: int,
  a_prev: int,           // index immediately before the entry being sent
  a_prev_term: int,      // its term — the consistency check compares this
  a_commit: int,         // how far the leader has committed
  a_ent_term: int,       // -1 for a heartbeat carrying no entry
  a_cmd: str
};

type event =
    Tick
  | RequestVote of (int * int * int * int)   // term, candidate, last index, last term
  | VoteGranted of (int * int)               // term, voter (sent only when granted)
  | Append of append
  | AppendResult of (int * int * int * int)  // term, from, 1 on success, match index
  | Propose of str;                          // a client asking for a command

// ---- wire format -----------------------------------------------------------
// One message per line, space-separated fields, the last of which may contain
// spaces. Text, because a protocol that can be read with `nc` while it is failing
// is worth more here than one that is compact.
let rec field_at = fn (s: str) -> fn (want: int) -> fn (i: int) -> fn (k: int) -> fn (acc: str) ->
  if i >= str_len s then acc
  else
    let c = substring s i (i + 1) in
    if str_eq c " " then
      (if k == want then acc else field_at s want (i + 1) (k + 1) "")
    else if k == want then field_at s want (i + 1) k (acc ++ c)
    else field_at s want (i + 1) k acc;

// Everything from field `k` to the end of the line, spaces included: a command is
// arbitrary text and must not be cut at the first space.
let rec rest_from = fn (s: str) -> fn (k: int) -> fn (i: int) -> fn (seen: int) ->
  if i >= str_len s then ""
  else if seen == k then substring s i (str_len s)
  else if str_eq (substring s i (i + 1)) " " then rest_from s k (i + 1) (seen + 1)
  else rest_from s k (i + 1) seen;

let num = fn (line: str) -> fn (k: int) -> int_of_str (field_at line k 0 0 "");

let decode = fn (line: str) ->
  let tag = field_at line 0 0 0 "" in
  if str_eq tag "RV" then RequestVote (num line 1, num line 2, num line 3, num line 4)
  else if str_eq tag "RVR" then VoteGranted (num line 1, num line 2)
  else if str_eq tag "AE" then
    Append (append { a_term = num line 1, a_leader = num line 2, a_prev = num line 3,
                     a_prev_term = num line 4, a_commit = num line 5,
                     a_ent_term = num line 6, a_cmd = rest_from line 7 0 0 })
  else if str_eq tag "AER" then
    AppendResult (num line 1, num line 2, num line 3, num line 4)
  else if str_eq tag "PROP" then Propose (rest_from line 1 0 0)
  else Tick;                        // an unparseable line costs one wasted tick

let enc2 = fn (tag: str) -> fn (a: int) -> fn (b: int) ->
  tag ++ " " ++ str_of_int a ++ " " ++ str_of_int b ++ chr 10;

let enc4 = fn (tag: str) -> fn (a: int) -> fn (b: int) -> fn (c: int) -> fn (d: int) ->
  tag ++ " " ++ str_of_int a ++ " " ++ str_of_int b ++ " " ++ str_of_int c
      ++ " " ++ str_of_int d ++ chr 10;

let enc_ae = fn (a: append) ->
  "AE " ++ str_of_int a.a_term ++ " " ++ str_of_int a.a_leader
        ++ " " ++ str_of_int a.a_prev ++ " " ++ str_of_int a.a_prev_term
        ++ " " ++ str_of_int a.a_commit ++ " " ++ str_of_int a.a_ent_term
        ++ " " ++ a.a_cmd ++ chr 10;

// ---- reading a connection (one thread per accepted connection) -------------
let rec read_line = fn (fd: int) -> fn (scratch: int) -> fn (acc: str) ->
  let n = tcp_read fd scratch 1 in
  if n < 1 then ""                  // EOF or error: the caller closes
  else
    let b = mem_get_u8 scratch 0 in
    if b == 10 then acc
    else if b == 13 then read_line fd scratch acc     // a client typing CRLF
    else read_line fd scratch (acc ++ chr b);

let rec reader = fn (fd: int) -> fn (inbox) -> fn (scratch: int) ->
  let line = read_line fd scratch "" in
  if str_len line == 0 then tcp_close fd
  else
    let _ = channel_send inbox (decode line) in
    reader fd inbox scratch;

// ---- sending to one peer (one thread per peer) -----------------------------
// The connection is made on demand and remade after a failure, so a peer that is
// not up yet, or that dies and comes back, costs one dropped message rather than
// a stalled cluster. Dropping is allowed: Raft's RPCs are best-effort, and the
// election timeout and the next heartbeat are what turn a lost message back into
// progress.
//
// M4: `--chaos <pct>` makes that claim testable instead of merely stated. Each
// outbound message independently gets, with probability `pct`:
//
//   dropped      never written, and nothing tells the other end
//   duplicated   written twice, so every handler must be idempotent
//   held back    kept and sent after the next one, so order is not a given
//
// TCP gives none of these away on a single connection, which is exactly why a
// protocol that only ever ran over localhost TCP has never been asked the
// question. The three faults live in the sender thread because that is the only
// place a message can be interfered with without the rest of the program being
// able to tell — a fault injector the program can detect is not testing anything.
let rec sender = fn (port: int) -> fn (out_ch) -> fn (buf: int) -> fn (fd: int) ->
                 fn (chaos: int) -> fn (held: str) ->
  let m = channel_recv out_ch in
  let roll = fn () -> if chaos <= 0 then 100 else random_int 100 in
  if roll () < chaos then
    // Dropped. The held message stays held: a lost message must not shake loose
    // whatever was already waiting, or "dropped" would quietly mean "delayed".
    sender port out_ch buf fd chaos held
  else if str_len held == 0 && roll () < chaos then
    sender port out_ch buf fd chaos m       // held back, to go out after the next
  else
    let live = if fd >= 0 then fd else tcp_connect "127.0.0.1" port in
    if live < 0 then sender port out_ch buf (0 - 1) chaos held
    else
      // The newer message first, then whatever was held: that is what makes the
      // reordering visible rather than a uniform delay.
      let dup = roll () < chaos in
      let out = m ++ (if dup then m else "") ++ held in
      let n = mem_copy_str buf 0 out in
      let w = tcp_write live buf n in
      if w < 0 then
        let _ = tcp_close live in
        sender port out_ch buf (0 - 1) chaos held
      else sender port out_ch buf live chaos "";

// Peers are (id, outbox) pairs rather than a bare list of channels, because a
// vote has an addressee. Sending one to everybody is not a wasteful broadcast —
// it is wrong: every candidate in that term counts it as a vote for itself, and a
// three-node cluster elects two leaders in one term. That is what this program
// did until the invariant check in verify.sh caught it.
let rec broadcast = fn (outs) -> fn (m: str) ->
  match outs with
  | Nil -> ()
  | Cons ((_, ch), rest) -> let _ = channel_send ch m in broadcast rest m;

let rec send_to = fn (outs) -> fn (who: int) -> fn (m: str) ->
  match outs with
  | Nil -> ()                       // a peer we have no channel for: drop it
  | Cons ((pid, ch), rest) ->
    if pid == who then let _ = channel_send ch m in () else send_to rest who m;

// ---- the log ---------------------------------------------------------------
let rec skip = fn (log: entry list) -> fn (k: int) ->
  if k <= 0 then log
  else
    match log with
    | Nil -> Nil
    | Cons (_, rest) -> skip rest (k - 1);

let entry_at = fn (log: entry list) -> fn (size: int) -> fn (i: int) ->
  if i <= 0 || i > size then Entry (0, "")
  else
    match skip log (size - i) with
    | Nil -> Entry (0, "")
    | Cons (e, _) -> e;

// The term of index `i`: 0 before the log starts, which every log agrees on and is
// what makes the consistency check bottom out; -1 for an index this node does not
// have, which no real term equals, so the check fails rather than passing by
// accident.
let term_at = fn (log: entry list) -> fn (size: int) -> fn (i: int) ->
  if i <= 0 then 0
  else if i > size then 0 - 1
  else match entry_at log size i with Entry (t, _) -> t;

// ---- the write-ahead log ---------------------------------------------------
// Write one record and make it durable before returning. The fsync is the whole
// point: a node that answers "I have it" and then loses it on a power cut has
// broken the only promise the protocol makes on its behalf, and a majority of
// such answers is how a committed entry disappears.
//
// This used to build a `Vec` with one boxed int per byte, because `file_pwrite`
// takes `Vec[int]` — it predates the `bytes` type by a hundred versions. Reported
// as PAIN.md P7 and fixed upstream in mere v0.1.222, which added
// `file_pwrite_bytes`; the conversion a record needs is now `bytes_of_str`.
let wal_write = fn (h: File) -> fn (off: int) -> fn (line: str) ->
  let n = file_pwrite_bytes h off (bytes_of_str line) in
  let _ = file_fsync h in
  off + n;

let persist_vote = fn (st: node) ->
  { st | wal_end = wal_write st.wal st.wal_end
                     ("T " ++ str_of_int st.term ++ " " ++ str_of_int st.voted_for
                      ++ chr 10) };

let persist_entry = fn (st: node) -> fn (i: int) -> fn (t: int) -> fn (cmd: str) ->
  { st | wal_end = wal_write st.wal st.wal_end
                     ("E " ++ str_of_int i ++ " " ++ str_of_int t ++ " " ++ cmd
                      ++ chr 10) };

let rec split_lines = fn (text: str) -> fn (i: int) -> fn (acc: str) -> fn (out) ->
  if i >= str_len text then
    (if str_len acc == 0 then out else Cons (acc, out))
  else
    let c = substring text i (i + 1) in
    if str_eq c (chr 10) then split_lines text (i + 1) "" (Cons (acc, out))
    else split_lines text (i + 1) (acc ++ c) out;

// Replay, oldest record first, returning (term, voted for, log newest-first, size).
// The log is rebuilt by the same rule the file was written under: an entry at an
// index we already have replaces it, and everything above it goes.
let rec replay = fn (lines: str list) -> fn (term: int) -> fn (voted: int) ->
                 fn (log: entry list) -> fn (size: int) ->
  match lines with
  | Nil -> (term, voted, log, size)
  | Cons (line, rest) ->
    let tag = field_at line 0 0 0 "" in
    if str_eq tag "T" then replay rest (num line 1) (num line 2) log size
    else if str_eq tag "E" then
      let i = num line 1 in
      let t = num line 2 in
      let cmd = rest_from line 3 0 0 in
      let kept = if i <= size then skip log (size - i + 1) else log in
      replay rest term voted (Cons (Entry (t, cmd), kept)) i
    else replay rest term voted log size;

// ---- the node --------------------------------------------------------------
let next_deadline = fn () ->
  now_ms () + election_min_ms + random_int election_spread_ms;

let name_of = fn (r: role) ->
  match r with
  | Follower -> "follower"
  | Candidate -> "candidate"
  | Leader -> "leader";

let rec reset_peers = fn (ps) -> fn (nx: int) ->
  match ps with
  | Nil -> Nil
  | Cons ((pid, _, _), rest) -> Cons ((pid, nx, 0), reset_peers rest nx);

let rec set_peer = fn (ps) -> fn (who: int) -> fn (nx: int) -> fn (mt: int) ->
  match ps with
  | Nil -> Nil
  | Cons ((pid, n, m), rest) ->
    if pid == who then Cons ((pid, nx, mt), rest)
    else Cons ((pid, n, m), set_peer rest who nx mt);

let rec peer_next = fn (ps) -> fn (who: int) ->
  match ps with
  | Nil -> 1
  | Cons ((pid, n, _), rest) -> if pid == who then n else peer_next rest who;

let rec count_ge = fn (ps) -> fn (n: int) ->
  match ps with
  | Nil -> 0
  | Cons ((_, _, m), rest) -> (if m >= n then 1 else 0) + count_ge rest n;

// Everything from `applied + 1` up to `commit` goes to the state machine, in
// order. The state machine here is a line of output, which is enough for a test
// to check that every node applied the same commands in the same order — the
// property the whole protocol exists to provide.
let rec apply_upto = fn (st: node) ->
  if st.applied >= st.commit then st
  else
    let i = st.applied + 1 in
    let _ =
      match entry_at st.log st.size i with
      | Entry (t, cmd) ->
        print ("node " ++ str_of_int st.id ++ ": applied " ++ str_of_int i
               ++ " term=" ++ str_of_int t ++ " cmd="
               ++ (if str_len cmd == 0 then "<noop>" else cmd)) in
    apply_upto ({ st | applied = i });

// A node that learns of a term greater than its own is out of date, whatever it
// was doing: it becomes a follower of that term and forgets its vote. This one
// rule is what keeps two leaders from coexisting, and it is applied on every
// message rather than in any one place.
let step_down = fn (st: node) -> fn (t: int) ->
  // The new term and the cleared vote are on disk before this returns: a node that
  // forgot which term it was in could vote twice in it after a restart, which is
  // exactly how two leaders happen.
  persist_vote { st | term = t, part = Follower, voted_for = 0 - 1, votes = 0,
                      deadline = next_deadline (), leader = 0 - 1 };

// What a leader sends a particular peer: the entry at that peer's next index, or a
// bare heartbeat when the peer is caught up. `a_prev` is the index before it, and
// the follower refuses the whole message unless it has that index at that term —
// which is how a log that diverged gets found and rewound.
let ae_for = fn (st: node) -> fn (next: int) ->
  if next <= st.size then
    match entry_at st.log st.size next with
    | Entry (et, cmd) ->
      append { a_term = st.term, a_leader = st.id, a_prev = next - 1,
               a_prev_term = term_at st.log st.size (next - 1),
               a_commit = st.commit, a_ent_term = et, a_cmd = cmd }
  else
    append { a_term = st.term, a_leader = st.id, a_prev = st.size,
             a_prev_term = term_at st.log st.size st.size,
             a_commit = st.commit, a_ent_term = 0 - 1, a_cmd = "" };

let rec beat_peers = fn (st: node) -> fn (outs) -> fn (ps) ->
  match ps with
  | Nil -> ()
  | Cons ((pid, nx, _), rest) ->
    let _ = send_to outs pid (enc_ae (ae_for st nx)) in
    beat_peers st outs rest;

// The largest index a majority stores. Restricted to entries from the current
// term: an entry replicated by a majority but written in an older term is not safe
// to commit on that basis alone (Raft's figure 8), and committing it is the
// mistake that loses data.
let rec highest_committed = fn (st: node) -> fn (quorum: int) -> fn (n: int) ->
  if n <= st.commit then st.commit
  else if 1 + count_ge st.peers n >= quorum && term_at st.log st.size n == st.term then n
  else highest_committed st quorum (n - 1);

// Becoming leader appends one entry of its own: a no-op, with an empty command.
//
// Without it a new leader can never commit anything it inherited. `highest_committed`
// only counts an index as committed when the entry there is from the *current* term
// — Raft's figure 8, and not a detail: counting replicas of an older term's entry
// can commit something a later leader will legitimately overwrite. So a leader that
// starts with a log full of previous terms sits there holding entries it may not
// apply, and clients see a cluster that has their data and will not serve it. That
// is exactly what a whole-cluster restart looks like, and it is what made this
// missing: the entries came back from disk and nothing was ever applied again.
//
// One entry in the new term fixes it. When that commits on a majority, everything
// before it is committed too, by the same induction the consistency check relies on.
let become_leader = fn (st: node) -> fn (outs) -> fn (v: int) ->
  let st1 = { st | part = Leader, votes = v, leader = st.id, last_beat = now_ms (),
                   peers = reset_peers st.peers (st.size + 1) } in
  let _ = print ("node " ++ str_of_int st1.id ++ ": became leader for term "
                 ++ str_of_int st1.term ++ " with " ++ str_of_int v ++ " votes") in
  let st2 = persist_entry { st1 | log = Cons (Entry (st1.term, ""), st1.log),
                                  size = st1.size + 1 }
                          (st1.size + 1) st1.term "" in
  let _ = beat_peers st2 outs st2.peers in
  st2;

let start_election = fn (st: node) -> fn (outs) -> fn (quorum: int) ->
  let t = st.term + 1 in
  let _ = print ("node " ++ str_of_int st.id ++ ": election timeout, standing for term "
                 ++ str_of_int t) in
  // The candidate's last index and term travel with the request: a voter refuses a
  // candidate whose log is behind its own, which is what stops a node that missed
  // entries from being elected and overwriting them.
  let _ = broadcast outs (enc4 "RV" t st.id st.size (term_at st.log st.size st.size)) in
  if 1 >= quorum then
    become_leader (persist_vote { st | term = t, voted_for = st.id,
                                       deadline = next_deadline () }) outs 1
  else
    persist_vote { st | term = t, part = Candidate, voted_for = st.id, votes = 1,
                        deadline = next_deadline (), leader = 0 - 1 };

let on_tick = fn (st: node) -> fn (outs) -> fn (quorum: int) ->
  let now = now_ms () in
  match st.part with
  | Leader ->
    if now >= st.last_beat + heartbeat_ms then
      let _ = beat_peers st outs st.peers in
      { st | last_beat = now }
    else st
  | Follower -> if now >= st.deadline then start_election st outs quorum else st
  | Candidate -> if now >= st.deadline then start_election st outs quorum else st;

let on_request_vote = fn (st: node) -> fn (outs) -> fn (t: int) -> fn (cand: int) ->
                      fn (last_i: int) -> fn (last_t: int) ->
  let st1 = if t > st.term then step_down st t else st in
  let my_t = term_at st1.log st1.size st1.size in
  // The election restriction: "at least as up to date" means a later last term,
  // or the same last term and at least as many entries.
  let current = last_t > my_t || (last_t == my_t && last_i >= st1.size) in
  if t == st1.term && current && (st1.voted_for == 0 - 1 || st1.voted_for == cand) then
    // Durable before the answer goes out, in that order: a vote that is promised
    // and then forgotten is a vote that can be cast again.
    let st2 = persist_vote { st1 | voted_for = cand, deadline = next_deadline () } in
    let _ = send_to outs cand (enc2 "RVR" t st2.id) in
    let _ = print ("node " ++ str_of_int st2.id ++ ": voted for " ++ str_of_int cand
                   ++ " in term " ++ str_of_int t) in
    st2
  else
    let _ =
      if t == st1.term && current == false then
        print ("node " ++ str_of_int st1.id ++ ": refused " ++ str_of_int cand
               ++ " in term " ++ str_of_int t ++ " (its log is behind: "
               ++ str_of_int last_i ++ "/" ++ str_of_int last_t ++ " vs mine "
               ++ str_of_int st1.size ++ "/" ++ str_of_int my_t ++ ")")
      else () in
    st1;

let on_vote_granted = fn (st: node) -> fn (outs) -> fn (t: int) -> fn (quorum: int) ->
  let st1 = if t > st.term then step_down st t else st in
  match st1.part with
  | Candidate ->
    if t == st1.term then
      let v = st1.votes + 1 in
      if v >= quorum then become_leader st1 outs v
      else { st1 | votes = v }
    else st1
  | Follower -> st1
  | Leader -> st1;

let on_append = fn (st: node) -> fn (outs) -> fn (a: append) ->
  // A leader that hears from another leader of its OWN term is looking at a broken
  // invariant, not at news: stepping down would make each of the two demote the
  // other. Only a strictly greater term unseats a leader. A candidate must yield to
  // an equal term — that is someone having won the election it is still running.
  let stale =
    if a.a_term < st.term then true
    else match st.part with
         | Leader -> a.a_term == st.term
         | Follower -> false
         | Candidate -> false in
  if stale then
    // Answering a stale leader with our term is how it learns to step down.
    let _ = send_to outs a.a_leader (enc4 "AER" st.term st.id 0 0) in
    st
  else
    let _ =
      if st.leader == a.a_leader && st.term == a.a_term then ()
      else print ("node " ++ str_of_int st.id ++ ": following " ++ str_of_int a.a_leader
                  ++ " in term " ++ str_of_int a.a_term
                  ++ " (was " ++ name_of st.part ++ ")") in
    let st1 = { st | term = a.a_term, part = Follower,
                          voted_for = if a.a_term > st.term then 0 - 1 else st.voted_for,
                          votes = 0, deadline = next_deadline (),
                          leader = a.a_leader } in
    // The consistency check. A follower accepts an entry only if it already has the
    // entry before it, at the term the leader says — so one matching index implies
    // every earlier index matches, by induction, and a log that diverged is found
    // rather than silently kept.
    if term_at st1.log st1.size a.a_prev != a.a_prev_term then
      let _ = send_to outs a.a_leader (enc4 "AER" st1.term st1.id 0 0) in
      st1
    else
      let st2 =
        if a.a_ent_term < 0 then st1
        else
          // Anything after the matching point is discarded before appending: the
          // leader's log is the truth, and a follower that kept its own tail would
          // be a second history nobody agreed to.
          let kept = skip st1.log (st1.size - a.a_prev) in
          persist_entry { st1 | log = Cons (Entry (a.a_ent_term, a.a_cmd), kept),
                                size = a.a_prev + 1 }
                        (a.a_prev + 1) a.a_ent_term a.a_cmd in
      let mine = if a.a_ent_term < 0 then a.a_prev else a.a_prev + 1 in
      let st3 = { st2 | commit = if a.a_commit < st2.size then a.a_commit
                                      else st2.size } in
      let st4 = apply_upto st3 in
      let _ = send_to outs a.a_leader (enc4 "AER" st4.term st4.id 1 mine) in
      st4;

let on_append_result = fn (st: node) -> fn (outs) -> fn (t: int) -> fn (from: int) ->
                       fn (ok: int) -> fn (match_i: int) -> fn (quorum: int) ->
  if t > st.term then step_down st t
  else
    match st.part with
    | Leader ->
      if ok == 1 then
        let st1 = { st | peers = set_peer st.peers from (match_i + 1) match_i } in
        let c = highest_committed st1 quorum st1.size in
        apply_upto ({ st1 | commit = c })
      else
        // The peer refused: it does not have the entry before the one we sent, so
        // try one earlier. Walking back one index per round trip is Raft's simple
        // version, and is fine when logs diverge by a little.
        let nx = peer_next st.peers from in
        let back = if nx > 1 then nx - 1 else 1 in
        let st1 = { st | peers = set_peer st.peers from back 0 } in
        let _ = send_to outs from (enc_ae (ae_for st1 back)) in
        st1
    | Follower -> st
    | Candidate -> st;

// A client asked for a command. Only a leader may append: a follower that accepted
// one would be inventing history that no majority agreed to.
let on_propose = fn (st: node) -> fn (outs) -> fn (cmd: str) -> fn (quorum: int) ->
  match st.part with
  | Leader ->
    // On disk before it is replicated, and therefore before anybody can commit it.
    let st1 = persist_entry { st | log = Cons (Entry (st.term, cmd), st.log),
                                   size = st.size + 1 }
                            (st.size + 1) st.term cmd in
    let _ = print ("node " ++ str_of_int st1.id ++ ": accepted " ++ str_of_int st1.size
                   ++ " term=" ++ str_of_int st1.term ++ " cmd=" ++ cmd) in
    // Replicate at once rather than waiting for the next heartbeat, and let a
    // one-node cluster commit immediately.
    let _ = beat_peers st1 outs st1.peers in
    let c = highest_committed st1 quorum st1.size in
    apply_upto ({ st1 | commit = c })
  | Follower ->
    let _ = print ("node " ++ str_of_int st.id ++ ": rejected a proposal (not leader; "
                   ++ (if st.leader < 0 then "no leader known"
                       else "leader is " ++ str_of_int st.leader) ++ ")") in
    st
  | Candidate ->
    let _ = print ("node " ++ str_of_int st.id ++ ": rejected a proposal (mid-election)") in
    st;

let rec run = fn (st: node) -> fn (inbox) -> fn (outs) -> fn (quorum: int) ->
  let st2 =
    match channel_recv inbox with
    | Tick -> on_tick st outs quorum
    | RequestVote (t, cand, li, lt) -> on_request_vote st outs t cand li lt
    | VoteGranted (t, _) -> on_vote_granted st outs t quorum
    | Append (a) -> on_append st outs a
    | AppendResult (t, from, ok, mi) -> on_append_result st outs t from ok mi quorum
    | Propose (cmd) -> on_propose st outs cmd quorum in
  run st2 inbox outs quorum;

// ---- wiring ----------------------------------------------------------------
// The byte arena is a bump allocator with no free and is not thread-safe, so every
// buffer any thread will ever use is carved here, before anything is spawned — the
// rule `mkv` found. Readers borrow a slot from a channel and return it when their
// connection closes, which also caps how many peers and clients can be talking at
// once.
let reader_slots = 8;

let rec fill = fn (ch) -> fn (i: int) ->
  if i >= reader_slots then () else let _ = channel_send ch i in fill ch (i + 1);

let rec acceptor = fn (srv: int) -> fn (inbox) -> fn (free_ch) -> fn (base: int) ->
  let c = tcp_accept srv in
  if c < 0 then acceptor srv inbox free_ch base
  else
    let slot = channel_recv free_ch in
    let _ = spawn (fn () ->
      let _ = reader c inbox (base + slot * bufsz) in
      channel_send free_ch slot) in
    acceptor srv inbox free_ch base;

let rec ticker = fn (inbox) ->
  let _ = sleep_ms tick_ms in
  let _ = channel_send inbox Tick in
  ticker inbox;

// The cluster is given as every port in node-id order, so a peer's id is its
// position in that list. Ids and ports travel together from here on, because a
// vote has an addressee and the wire only carries ids.
let rec pairs_of = fn (ports: int list) -> fn (k: int) ->
  match ports with
  | Nil -> Nil
  | Cons (p, rest) -> Cons ((k, p), pairs_of rest (k + 1));

let rec without = fn (ps) -> fn (mine: int) ->
  match ps with
  | Nil -> Nil
  | Cons ((i, p), rest) ->
    if p == mine then without rest mine else Cons ((i, p), without rest mine);

// One sender thread per peer, each with its own outbox and write buffer.
let rec start_senders = fn (ps) -> fn (base: int) -> fn (k: int) -> fn (chaos: int) -> fn (acc) ->
  match ps with
  | Nil -> acc
  | Cons ((pid, p), rest) ->
    let out = channel_new () in
    let buf = base + k * bufsz in
    // `(p : int)` is not documentation. Without it the Send check refuses the
    // capture with "cannot capture `p` of unknown type across a thread boundary",
    // even though the list it came from is annotated — the check runs before that
    // has reached the pattern variable. PAIN.md P5.
    let peer_port = (p : int) in
    let peer_id = (pid : int) in
    let _ = spawn (fn () -> sender peer_port out buf (0 - 1) chaos "") in
    start_senders rest base (k + 1) chaos (Cons ((peer_id, out), acc));

let rec peer_slots = fn (ps) ->
  match ps with
  | Nil -> Nil
  | Cons ((pid, _), rest) -> Cons ((pid, 1, 0), peer_slots rest);

let rec rev_onto = fn (xs: str list) -> fn (acc: str list) ->
  match xs with
  | Nil -> acc
  | Cons (h, t) -> rev_onto t (Cons (h, acc));
let list_rev = fn (xs: str list) -> rev_onto xs Nil;

let rec ints_of = fn (xs: str list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> Cons (int_of_str h, ints_of t);

let rec length_of = fn (xs: int list) ->
  match xs with
  | Nil -> 0
  | Cons (_, t) -> 1 + length_of t;

let rec index_of = fn (xs: int list) -> fn (want: int) -> fn (k: int) ->
  match xs with
  | Nil -> 0 - 1
  | Cons (h, t) -> if h == want then k else index_of t want (k + 1);

let start = fn (id: int) -> fn (my_port: int) -> fn (ports: int list) -> fn (chaos: int) ->
  let cluster = length_of ports in
  let mine = index_of ports my_port 1 in
  if mine < 0 then
    print_err ("mraft: my port " ++ str_of_int my_port
               ++ " is not in the cluster list")
  else if mine != id then
    // Ids are positions, so an id that disagrees with the port order would make
    // two nodes answer to the same name and every vote go to the wrong place.
    print_err ("mraft: node id " ++ str_of_int id ++ " does not match position "
               ++ str_of_int mine ++ " of port " ++ str_of_int my_port
               ++ " in the cluster list")
  else
    let srv = tcp_listen my_port in
    if srv < 0 then
      print_err ("mraft: could not listen on :" ++ str_of_int my_port)
    else
      let quorum = cluster / 2 + 1 in
      let _ = print ("node " ++ str_of_int id ++ ": listening on :" ++ str_of_int my_port
                     ++ ", cluster of " ++ str_of_int cluster
                     ++ ", quorum " ++ str_of_int quorum
                     ++ (if chaos > 0 then
                           ", chaos " ++ str_of_int chaos
                           ++ "% (drop / duplicate / reorder, per message)"
                         else "")) in
      let peer_list = without (pairs_of ports 1) my_port in
      let inbox = channel_new () in
      let free_ch = channel_new () in
      // Reader slots first, then one write buffer per peer.
      let base = mem_alloc ((reader_slots + cluster) * bufsz) in
      let _ = fill free_ch 0 in
      let outs = start_senders peer_list (base + reader_slots * bufsz) 0 chaos Nil in
      let _ = spawn (fn () -> acceptor srv inbox free_ch base) in
      let _ = spawn (fn () -> ticker inbox) in
      // Recovery happens before anything is served: a node that answered a vote
      // request while still reading its own past could contradict it.
      let path = "mraft-" ++ str_of_int id ++ ".wal" in
      let text = if file_exists path then read_file path else "" in
      // split_lines conses, so it comes out newest-first; replay wants the order
      // the records were written in.
      let ordered = list_rev (split_lines text 0 "" Nil) in
      match replay ordered 0 (0 - 1) Nil 0 with
      | (rterm, rvoted, rlog, rsize) ->
        let _ =
          if rsize > 0 || rterm > 0 then
            print ("node " ++ str_of_int id ++ ": recovered term " ++ str_of_int rterm
                   ++ ", vote " ++ str_of_int rvoted ++ ", " ++ str_of_int rsize
                   ++ " entries from " ++ path)
          else () in
        let h = file_openrw path in
        // Commit and applied are deliberately not persisted: Raft calls them
        // volatile, and a restarted node learns how far to apply from the leader.
        // The cost is that its state machine replays from the start, which a real
        // one has to be idempotent about and which here means printing again.
        run (node { id = id, term = rterm, part = Follower, voted_for = rvoted,
                    votes = 0, deadline = next_deadline (), last_beat = 0,
                    leader = 0 - 1, log = rlog, size = rsize, commit = 0,
                    applied = 0, peers = peer_slots peer_list,
                    wal = h, wal_end = str_len text })
            inbox outs quorum;

// `--chaos <pct>` may appear anywhere after the ports; everything else is a port.
let rec chaos_arg = fn (xs: str list) ->
  match xs with
  | Nil -> 0
  | Cons (h, t) ->
    if str_eq h "--chaos" then
      (match t with Cons (v, _) -> int_of_str v | Nil -> 0)
    else chaos_arg t;

let rec drop_flags = fn (xs: str list) -> fn (skip_one: bool) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) ->
    if skip_one then drop_flags t false
    else if str_eq h "--chaos" then drop_flags t true
    else Cons (h, drop_flags t false);

let usage = "usage: mraft <id> <my-port> <port>... [--chaos <pct>]";

let main = fn () ->
  match args () with
  | Cons (id_s, Cons (port_s, rest)) ->
    let id = int_of_str id_s in
    let my_port = int_of_str port_s in
    let chaos = chaos_arg rest in
    let ports = ints_of (drop_flags rest false) in
    (match ports with
     | Nil -> print usage
     | Cons (_, _) -> start id my_port ports chaos)
  | _ -> print usage;

main ()
